# Application Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Database (MongoDB Single-Node Replica Set)
MONGODB_URI=mongodb://localhost:27017/hostel_db?replicaSet=rs0&directConnection=true

# Redis & Queue
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_ACCESS_SECRET=super-secret-access-token-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=super-secret-refresh-token-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Field-Level Encryption (AES-256-GCM, 32-byte / 64-char Hex Key)
ENCRYPTION_KEY_V1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY_ACTIVE_VERSION=v1

# Notifications (Console for dev, SMTP for production)
EMAIL_PROVIDER=console
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=test
SMTP_PASS=test
SMTP_FROM="Hostel Admin <no-reply@hostel.university.edu>"
SMS_PROVIDER=console

# External / P04 Integration
PUBLIC_API_KEY=hostel-p04-occupancy-api-key-secret
P04_API_KEY=p04-default-shared-key-2026
